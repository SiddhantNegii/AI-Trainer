# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed.

# Base URL of the backend API.
# Local dev: http://localhost:8002 (matches backend default PORT)
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8002

# Optional alternative configs (legacy — prefer NEXT_PUBLIC_API_URL above):
# NEXT_PUBLIC_API_HOST=your-backend.onrender.com
# NEXT_PUBLIC_API_HOSTPORT=your-backend.onrender.com:443
